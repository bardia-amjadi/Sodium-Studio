<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Visual Studio "Dark" inspired palette -->
    <Color x:Key="WindowBackground">#1E1E1E</Color>
    <Color x:Key="TitleBarBackground">#2D2D30</Color>
    <Color x:Key="SidebarBackground">#252526</Color>
    <Color x:Key="StatusBarBackground">#007ACC</Color>
    <Color x:Key="BorderColor">#3F3F46</Color>
    <Color x:Key="SelectionBackground">#094771</Color>
    <Color x:Key="DisabledBackground">#3C3C3C</Color>

    <Color x:Key="TextPrimary">#D4D4D4</Color>
    <Color x:Key="TextSecondary">#9D9D9D</Color>
    <Color x:Key="TextDisabled">#6E6E6E</Color>
    <Color x:Key="Accent">#007ACC</Color>

    <Color x:Key="ErrorBackground">#5A1D1D</Color>
    <Color x:Key="ErrorText">#F48771</Color>
    <Color x:Key="InfoBackground">#063B49</Color>

</ResourceDictionary>
