<Project Sdk="Microsoft.NET.Sdk">

  <!-- Phase 1 — UNVERIFIED: this project has never been built. See docs/PHASE1-VERIFICATION.md. -->

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>SodiumStudio</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Sodium Studio</ApplicationTitle>
    <ApplicationId>com.sodiumstudio.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Android 12 (API 31) and later -->
    <SupportedOSPlatformVersion>31.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1E1E1E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E1E1E" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Phase 2 source editor (MIT, preview). Brings RichEdit.Maui transitively; requires
         Microsoft.Maui.Controls >= 10.0.101. If restore reports NU1605/NU1608, set <MauiVersion>
         to at least 10.0.101 or update the MAUI workload. -->
    <PackageReference Include="CodeEdit.Maui" Version="0.4.0-preview.3" />
  </ItemGroup>

</Project>
